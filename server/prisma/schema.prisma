generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  primaryColor String?  @map("primary_color")
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  users         User[]
  leads         Lead[]
  webhooks      Webhook[]
  notifications Notification[]
  rules         Rule[]

  @@map("companies")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("user")
  companyId String?   @map("company_id")
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("users")
}

model Lead {
  id              String     @id @default(uuid())
  name            String
  email           String?
  phone           String?
  contactPhone    String?    @map("contact_phone")
  serviceInterest String?    @map("service_interest")
  city            String?
  budget          String?
  receiptImage    String?    @map("receipt_image")
  source          String     @default("whatsapp")
  status          String     @default("nuevo")
  notes           String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  companyId       String     @map("company_id")
  company         Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  activities      Activity[]

  @@index([companyId])
  @@map("leads")
}

model Activity {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  type        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("activities")
}

model Webhook {
  id        String    @id @default(uuid())
  url       String
  secret    String
  events    String[]
  active    Boolean   @default(true)
  companyId String?   @map("company_id") // null = global (visible para admins)
  company   Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId])
  @@map("webhooks")
}

model Notification {
  id        String    @id @default(uuid())
  companyId String    @map("company_id")
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String?
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([companyId, readAt])
  @@map("notifications")
}

model Rule {
  id         String   @id @default(uuid())
  name       String
  active     Boolean  @default(true)
  trigger    String   // 'lead.created' | 'lead.status_changed' | 'lead.updated'
  conditions Json     // [{ field, op, value }]
  actions    Json     // [{ type, value }]
  companyId  String   @map("company_id")
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("rules")
}
